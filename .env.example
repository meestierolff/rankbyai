# RankbyAI environment variables (names only; see docs/SETUP.md).
# Copy to .env.local for local development. Never commit real values.
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# Database (Neon). Locally, `pnpm db:setup` fills these three in.
DATABASE_URL=                   # Postgres connection string: migrations only (scripts/db.mjs), never used by the running app
DATA_API_URL=                   # Neon Data API base URL (https://...neon.tech/neondb/rest/v1), or local PostgREST
DATA_API_JWT_PRIVATE_JWK=       # private signing key as one-line JSON (node scripts/db.mjs keys). Secret.

# Sign-in (Neon Auth, Google)
NEON_AUTH_BASE_URL=             # from the Neon console, Auth tab
NEON_AUTH_COOKIE_SECRET=        # openssl rand -base64 48

# File storage (Neon Object Storage, S3-compatible). Optional: without it, logo upload is off.
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_REGION=

KEY_ENCRYPTION_SECRET=          # 32 random bytes, base64:  openssl rand -base64 32
HASH_PEPPER=                    # openssl rand -hex 32
CRON_SECRET=                    # openssl rand -hex 32

# House keys: used ONLY for free checks, included-scan packs and the operator's own demos
HOUSE_DATAFORSEO_LOGIN=
HOUSE_DATAFORSEO_PASSWORD=
HOUSE_OPENAI_API_KEY=
HOUSE_PERPLEXITY_API_KEY=
HOUSE_GEMINI_API_KEY=
DATAFORSEO_PINGBACK_SECRET=     # openssl rand -hex 32
OPENAI_MODEL=
PERPLEXITY_MODEL=
GEMINI_MODEL=
LLM_FIXES_MODEL=

STRIPE_SECRET_KEY=              # rk_test_... or sk_test_... until the operator approves live mode (see docs/SETUP.md for the permissions)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=   # not needed: checkout is a redirect to Stripe
STRIPE_WEBHOOK_SECRET=
STRIPE_PRODUCT_LIFETIME=
STRIPE_PRICE_PACK_25=
STRIPE_PRICE_PACK_100=
STRIPE_TAX_CODE_SAAS=

LADDER_BASE_CENTS=2900
LADDER_STEP_CENTS=1000
LADDER_STEP_EVERY=5
LADDER_CLOSES_AT=2026-12-16T13:00:00Z
EARLY_ACCESS_NOTE=

COST_MAX_PER_CREDIT_USD=0.30
COST_DAILY_HOUSE_CAP_USD=15
COST_DAILY_FREE_CAP_USD=3
FREE_CHECKS_PER_EMAIL=1
FREE_CHECKS_PER_IP_PER_DAY=3

# Email: EMAIL_FROM plus ONE provider key. EMAIL_FROM must be a sender the provider has verified.
BREVO_API_KEY=
RESEND_API_KEY=
EMAIL_FROM=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
SOD_TRACKER_SNIPPET_SRC=
DATAFORSEO_AFFILIATE_URL=
ADMIN_USER_IDS=
LEGAL_ENTITY_NAME=
LEGAL_ADDRESS=
LEGAL_EMAIL=
LEGAL_KVK=
