# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# keep the example
!.env.example

# test + lighthouse output
/.lighthouse
/test-results

# browser automation output
/.playwright-mcp

# copied from node_modules at install
/public/vendor

# private research references: never commit (third-party screenshots, other-project material)
/docs/references

# local database stack secrets
/db/local/.env
.env.neon.local
.env.neon.preview.local

# Built plugin packages (scripts/build-openai-plugin.mjs)
/dist
docs/APPSUMO.md
.claude/settings.json
